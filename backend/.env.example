# Backend configuration. Copy to .env for local (non-Docker) development:
#   cp .env.example .env
# Every value below is also the built-in default, so the file is optional.

# --- Application ---
APP_NAME=DevOps Insights
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL, user admin / password admin) ---
DATABASE_URL=postgresql+psycopg://admin:admin@localhost:5432/devops_insights

# --- AI (Ollama, optional) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=120

# --- GitHub collection ---
GITHUB_API_URL=https://api.github.com
# Optional. Unauthenticated requests are limited to 60 per hour; a token raises this to 5000.
# A token without any scopes is enough because only public data is read.
GITHUB_TOKEN=
GITHUB_TIMEOUT=15

# --- Collector worker ---
COLLECTION_INTERVAL_SECONDS=21600
COLLECTION_ON_STARTUP=true
COLLECTOR_METRICS_PORT=9102
