# Optional overrides for Docker Compose. Copy to .env to use them:
#   cp .env.example .env
# Nothing here is required: every component has a working default.

# GitHub allows 60 unauthenticated API requests per hour. One collection uses 19, so a
# token is recommended if you collect often. A token with NO scopes is enough, because
# only public data is read. Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Model used for AI analysis (pulled automatically on first start).
OLLAMA_MODEL=qwen3:1.7b

# How often the collector runs, in seconds (default: 6 hours).
COLLECTION_INTERVAL_SECONDS=21600

# Set to false to wait for the first interval instead of collecting right at startup.
COLLECTION_ON_STARTUP=true
